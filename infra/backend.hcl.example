# Pass with: terraform init -backend-config=backend.hcl
# R2 is S3-compatible; endpoint uses the account id.

bucket = "launchpilot-tfstate"
key    = "launchpilot/terraform.tfstate"

endpoints = { s3 = "https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com" }
region    = "auto"

# Never commit real keys. Export them instead:
#   export AWS_ACCESS_KEY_ID=<r2_access_key_id>
#   export AWS_SECRET_ACCESS_KEY=<r2_secret_access_key>
skip_credentials_validation = true
skip_region_validation      = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
