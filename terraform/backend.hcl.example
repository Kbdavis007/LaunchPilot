# Pass with: terraform init -backend-config=backend.hcl
# R2 is S3-compatible; the endpoint embeds the account id, which a backend block
# cannot read from a variable.
bucket = "launchpilot-tfstate"
key    = "production/terraform.tfstate"
region = "auto"

endpoints = {
  s3 = "https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com"
}

skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
use_path_style              = true
use_lockfile                = true

# Never commit real keys. Export them instead:
#   export AWS_ACCESS_KEY_ID=<r2_access_key_id>
#   export AWS_SECRET_ACCESS_KEY=<r2_secret_access_key>
